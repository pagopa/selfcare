                          <tbody>\n                                                            <tr>\n                                                                <td align=\"left\" class=\"titolo\"\n                                                                    style=\"font-size:0px;padding:10px 25px;word-break:break-word;\">\n                                                                    <div\n                                                                        style=\"font-family:Titillium Web, Arial;font-size:13px;font-weight:bold;line-height:1;text-align:left;color:#17324D;\">\n                                                                        <h1 style=\"font-size:32px; line-height:40px;\">Conferma la tua identità</h1>\n                                                                    </div>\n                                                                </td>\n                                                            </tr>\n                                                            <tr>\n                                                                <td align=\"left\" class=\"intro\"\n                                                                    style=\"font-size:0px;padding:10px 25px;word-break:break-word;\">\n                                                                    <div\n                                                                        style=\"font-family:Titillium Web, Arial;font-size:16px;font-weight:400;line-height:24px;text-align:left;color:#17324D;\">\n                                                                        <p>Ciao {{name}},</p>\n                                                                        <p></p>\n                                                                        <p>per proteggere il tuo profilo, ti chiediamo di confermare che sei tu ad aver effettuato l'accesso.</p>\n                                                                        <p>Inserisci questo codice a 6 cifre per confermare la tua richiesta di accesso:</p>\n                                                                        <p><b style=\"font-size:24px\">{{otp}}</b></p>\n                                                                        <p>\n                                                                            <div style=\"font-family:Titillium Web, Arial;font-size:16px;font-weight:regular;line-height:24px;text-align:left;color:#17324D;\">\n                                                                                <a href=\"https://docs.pagopa.it/area-riservata/area-riservata/come-funziona/panoramica\"\n                                                                                    style=\"color: #0073E6;\">Perchè chiediamo una verifica?</a>\n                                                                            </div>\n                                                                        </p>\n                                                                    </div>\n                                                                </td>\n                                                            </tr>\n                                                            <!-- FAQ -->\n                                                            <tr>\n                                                                <td align=\"left\"\n                                                                    style=\"font-size:0px;padding:10px 25px;word-break:break-word;\">\n                                                                    <div\n                                                                        style=\"font-family:Titillium Web, Arial;font-size:16px;font-weight:regular;line-height:24px;text-align:left;color:#17324D;\">\n                                                                        <p>Se non hai effettuato tu l'accesso, segnalalo\n                                                                            a <a href=\"mailto:areariservata@assistenza.pagopa.it\"\n                                                                                style=\"color: #0073E6;\">areariservata@assistenza.pagopa.it</a>.\n                                                                        </p>\n                                                                    </div>\n                                                                </td>\n                                                            </tr>\n                                                            <tr>\n                                                                <td align=\"left\"\n                                                                    style=\"font-size:0px;padding:10px 25px;word-break:break-word;\">\n                                                                    <div\n                                                                        style=\"font-family:Titillium Web, Arial;font-size:16px;line-height:24px;text-align:left;color:#17324D;\">\n                                                                        <p>A presto,<br aria-hidden=\"true\">il team di\n                                                                            PagoPA S.p.A.</p>\n                                                                    </div>\n                                                                </td>\n                                                            </tr>\n                                                        </tbody>\n                                                    </table>\n                                                </div><!--[if mso | IE]></td></tr></table><![endif]-->\n                                            </td>\n                                        </tr>\n                                    </tbody>\n                                </table>\n                            </div>\n                            <!--[if mso | IE]></td></tr></table></td></tr><tr><td class=\"\" width=\"600px\" ><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n                            <div style=\"margin:0px auto;max-width:600px;\">\n                                <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\"\n                                    style=\"width:100%;\">\n                                    <tbody>\n                                        <tr>\n                                            <td style=\"direction:ltr;font-size:0px;padding:20px 0;text-align:center;\">\n                                                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:600px;\" ><![endif]-->\n                                                <div class=\"mj-column-per-100 mj-outlook-group-fix\"\n                                                    style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n                                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\n                                                        role=\"presentation\" style=\"vertical-align:top;\" width=\"100%\">\n                                                        <tbody>\n                                                            <tr>\n                                                                <td class=\"spaziatura\"\n                                                                    style=\"font-size:0px;word-break:break-word;\">\n                                                                    <div style=\"height:8px;line-height:8px;\">&#8202;\n                                                                    </div>\n                     