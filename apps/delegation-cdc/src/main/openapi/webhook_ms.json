{
  "openapi": "3.0.3",
  "tags": [
    {
      "name": "System",
      "description": "System information"
    },
    {
      "name": "Webhook",
      "description": "API for webhook configuration management"
    },
    {
      "name": "Webhook Notification",
      "description": "API for resending webhook notifications"
    },
    {
      "name": "external-v2"
    },
    {
      "name": "internal-v1"
    }
  ],
  "paths": {
    "/info/version": {
      "get": {
        "summary": "Get application version",
        "description": "Retrieve the current version of the application",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/webhooks": {
      "get": {
        "summary": "List webhooks",
        "description": "Retrieve a paginated list of webhook configurations, optionally filtered by tenant",
        "operationId": "listWebhooks",
        "tags": [
          "Webhook",
          "internal-v1"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "format": "int32",
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "name": "tenantId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WebhookResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new webhook",
        "description": "Create a new webhook configuration",
        "operationId": "createWebhook",
        "tags": [
          "Webhook",
          "external-v2"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/webhooks/notifications/resend": {
      "post": {
        "summary": "Resend notifications by status",
        "description": "Reset every notification matching the given status (optionally restricted to a single webhook) to PENDING and re-publish them for delivery",
        "operationId": "resendNotificationsByStatus",
        "tags": [
          "internal-v1"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/NotificationStatus",
              "default": "FAILED"
            }
          },
          {
            "name": "webhookId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/webhooks/notifications/resend/date-range": {
      "post": {
        "summary": "Resend notifications created within a date range",
        "description": "Reset every notification created between the given ISO-8601 date-times (e.g. 2024-01-01T00:00:00) to PENDING and re-publish them for delivery",
        "operationId": "resendNotificationsByDateRange",
        "tags": [
          "internal-v1"
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "pattern": "\\S",
              "type": "string"
            },
            "required": true
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "pattern": "\\S",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/webhooks/notifications/{notificationId}/resend": {
      "post": {
        "summary": "Resend a notification by ID",
        "description": "Reset a single notification to PENDING and re-publish it for delivery",
        "operationId": "resendNotificationById",
        "tags": [
          "internal-v1"
        ],
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/webhooks/notify": {
      "post": {
        "summary": "Send notification",
        "description": "Create and send a webhook notification",
        "operationId": "sendNotification",
        "tags": [
          "Webhook",
          "internal-v1"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/webhooks/{productId}": {
      "put": {
        "summary": "Update webhook",
        "description": "Update an existing webhook configuration",
        "operationId": "updateWebhookbyProductId",
        "tags": [
          "Webhook",
          "external-v2"
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      },
      "get": {
        "summary": "Get webhook by ID",
        "description": "Retrieve a specific webhook configuration",
        "operationId": "getWebhookbyProductId",
        "tags": [
          "Webhook",
          "external-v2"
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenantId",
            "in": "query",
            "schema": {
              "pattern": "\\S",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      },
      "delete": {
        "summary": "Delete webhook",
        "description": "Delete a webhook configuration",
        "operationId": "deleteWebhookbyProductId",
        "tags": [
          "Webhook"
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LocalDateTime": {
        "format": "date-time",
        "type": "string",
        "example": "2022-03-10T12:15:50"
      },
      "NotificationRequest": {
        "required": [
          "productId",
          "tenantId",
          "payload",
          "topic"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "pattern": "\\S",
            "type": "string"
          },
          "tenantId": {
            "pattern": "\\S",
            "type": "string"
          },
          "payload": {
            "pattern": "\\S",
            "type": "string"
          },
          "topic": {
            "pattern": "\\S",
            "type": "string"
          }
        }
      },
      "NotificationStatus": {
        "enum": [
          "PENDING",
          "SENDING",
          "DELIVERED",
          "FAILED",
          "RETRY"
        ],
        "type": "string"
      },
      "RetryPolicyRequest": {
        "type": "object",
        "properties": {
          "maxAttempts": {
            "format": "int32",
            "type": "integer"
          },
          "initialDelayMs": {
            "format": "int64",
            "type": "integer"
          },
          "maxDelayMs": {
            "format": "int64",
            "type": "integer"
          },
          "backoffMultiplier": {
            "format": "double",
            "type": "number"
          }
        }
      },
      "RetryPolicyResponse": {
        "type": "object",
        "properties": {
          "maxAttempts": {
            "format": "int32",
            "type": "integer"
          },
          "initialDelayMs": {
            "format": "int64",
            "type": "integer"
          },
          "maxDelayMs": {
            "format": "int64",
            "type": "integer"
          },
          "backoffMultiplier": {
            "format": "double",
            "type": "number"
          }
        }
      },
      "WebhookRequest": {
        "required": [
          "url",
          "tenantId",
          "productId",
          "httpMethod"
        ],
        "type": "object",
        "properties": {
          "url": {
            "pattern": "\\S",
            "type": "string"
          },
          "tenantId": {
            "pattern": "\\S",
            "type": "string"
          },
          "productId": {
            "pattern": "\\S",
            "type": "string"
          },
          "httpMethod": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retryPolicy": {
            "$ref": "#/components/schemas/RetryPolicyRequest"
          }
        }
      },
      "WebhookResponse": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "httpMethod": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "products": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "retryPolicy": {
            "$ref": "#/components/schemas/RetryPolicyResponse"
          },
          "createdAt": {
            "$ref": "#/components/schemas/LocalDateTime"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/LocalDateTime"
          }
        }
      }
    },
    "securitySchemes": {
      "SecurityScheme": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Authentication"
      }
    }
  },
  "info": {
    "title": "Webhook Service API",
    "version": "0.1.0",
    "description": "API per la gestione e invio di notifiche via webhook HTTP"
