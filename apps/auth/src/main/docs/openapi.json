    "/token/service" : {
      "post" : {
        "summary" : "Issue a machine access token",
        "description" : "Exchange an Entra app-only access token for a tenant-bound, authorized service token.",
        "operationId" : "issueMachineToken",
        "tags" : [ "Machine authentication" ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MachineTokenRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Machine access token",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MachineTokenResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid request"
          },
          "401" : {
            "description" : "Invalid Entra credential"
          },
          "403" : {
            "description" : "Machine identity is not authorized"
          },
          "404" : {
