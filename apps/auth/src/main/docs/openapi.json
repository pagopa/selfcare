      "post" : {
        "summary" : "Login SAML endpoint",
        "description" : "Login SAML endpoint provides a token exchange releasing a jwt session token",
        "operationId" : "loginSaml",
        "tags" : [ "SAML" ],
        "requestBody" : {
          "content" : {
            "application/x-www-form-urlencoded" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "SAMLResponse" : {
                    "type" : "string"
