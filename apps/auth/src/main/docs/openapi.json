      "get" : {
        "summary" : "Get OTP mail information",
        "description" : "Retrieve the processing status of an email managed by OneMail",
        "operationId" : "getOtpMailInfo",
        "tags" : [ "support", "OTP" ],
        "parameters" : [ {
          "name" : "mailRequestId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OtpMailInfoResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Bad Request",
            "content" : {
              "application/json" : {
